{
  "extends": ["claude-code-lore"],
  "filesystem": {
    "allow": [
      "$HOME/.claude-personal",
      "$HOME/portable-dotfiles/claude/.claude-personal"
    ],
    "deny": ["$HOME/.claude-work", "$HOME/.claude"]
  },
  "environment": {
    "set_vars": {
      "CLAUDE_CODE_TMPDIR": "$HOME/.claude-personal/tmp",
      "TMPDIR": "$HOME/.claude-personal/tmp/claude-$UID"
    }
  },
  "meta": {
    "name": "claude-code-personal",
    "description": "Claude Code with shared dotfiles access for personal work"
  },
  "network": {
    "allow_domain": [
      "getzola.org",
      "ico.org.uk",
      "news.ycombinator.com",
      "www.getzola.org"
    ],
    "open_port": [1111]
  }
}
