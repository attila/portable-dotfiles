{
  "extends": ["codex", "public-dotfiles-mirror", "root"],
  "environment": {
    "allow_vars": ["CODEX_HOME"]
  },
  "filesystem": {
    "allow_file": [{
      "path": "$HOME/Library/Keychains/login.keychain-db",
      "when": "macos"
    }, {
      "path": "$HOME/Library/Keychains/metadata.keychain-db",
      "when": "macos"
    }],
    "bypass_protection": [{
      "path": "$HOME/Library/Keychains/login.keychain-db",
      "when": "macos"
    }, {
      "path": "$HOME/Library/Keychains/metadata.keychain-db",
      "when": "macos"
    }],
    "read": ["$HOME/portable-dotfiles/codex"]
  },
  "meta": {
    "name": "codex-lore",
    "description": "Codex CLI with shared dotfiles access, OpenAI access, keychain access, and GPG seatbelt rules"
  },
  "network": {
    "allow_domain": [
      "*.chatgpt.com",
      "chatgpt.com",
      "mcp.context7.com",
      "api.openai.com",
      "auth.openai.com",
      "developers.openai.com",
      "platform.openai.com"
    ]
  },
  "unsafe_macos_seatbelt_rules": [
    "(allow mach-lookup (global-name \"com.apple.SecurityServer\"))",
    "(allow network-outbound (literal \"/Users/username/.gnupg/S.gpg-agent\"))"
  ]
}
