{
  "hooks": {
    "PreToolUse": [{
      "matcher": "AskUserQuestion",
      "hooks": [{
        "type": "command",
        "command": "$HOME/.config/claude/deny-ask-user-question.sh"
      }]
    }]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.config/claude/status-line.sh"
  }
}
