{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "newLineKind": "lf",
  "json": {
    "indentWidth": 2,
    "lineWidth": 80,
    "array.preferSingleLine": true
  },
  "markdown": {
    "lineWidth": 80,
    "textWrap": "always"
  },
  "toml": {
    "lineWidth": 80
  },
  "includes": ["**/*.{json,md,toml}"],
  "excludes": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.idea",
    "**/.vscode",
    "**/.fleet",
    "**/.zed",
    "**/node_modules",
    "**/.pnpm-store",
    "**/.yarn",
    "**/.npm",
    "**/dist",
    "**/build",
    "**/out",
    "**/.next",
    "**/.nuxt",
    "**/.svelte-kit",
    "**/.astro",
    "**/.output",
    "**/.turbo",
    "**/.parcel-cache",
    "**/.vercel",
    "**/.netlify",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/bun.lockb",
    "**/deno.lock",
    "**/Cargo.lock",
    "**/uv.lock",
    "**/poetry.lock",
    "**/Pipfile.lock",
    "**/composer.lock",
    "**/__pycache__",
    "**/.venv",
    "**/venv",
    "**/.tox",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/*.egg-info",
    "**/.ipynb_checkpoints",
    "**/target",
    "**/vendor",
    "**/.gradle",
    "**/.mvn",
    "**/coverage",
    "**/.nyc_output",
    "**/htmlcov",
    "**/.cache",
    "**/.sass-cache",
    "**/.tmp",
    "**/.terraform",
    "**/cdk.out",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.generated.*",
    "**/__snapshots__",
    "**/.claude/projects",
    "**/.claude/todos",
    "**/.claude/shell-snapshots",
    "**/.claude/statsig",
    "**/.DS_Store"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.21.3.wasm",
    "https://plugins.dprint.dev/markdown-0.22.1.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm"
  ]
}
