# Usage: <alias> [nono args...] -- [agent args...]
_nono_claude() {
    local profile="$1" config_dir="$2"; shift 2
    if [[ ! -d "$config_dir" ]]; then
        print -u2 "refusing: CLAUDE_CONFIG_DIR does not exist: $config_dir"
        return 1
    fi
    local nono_args=() agent_args=()
    while (( $# )); do
        if [[ "$1" == -- ]]; then shift; agent_args=("$@"); break; fi
        nono_args+=("$1"); shift
    done
    CLAUDE_CONFIG_DIR="$config_dir" nono run --allow-cwd --profile "$profile" \
        "${nono_args[@]}" -- claude "${agent_args[@]}"
}

_nono_codex() {
    local profile="$1" codex_home="$2"; shift 2
    if [[ ! -d "$codex_home" ]]; then
        print -u2 "refusing: CODEX_HOME does not exist: $codex_home"
        return 1
    fi
    local nono_args=() agent_args=()
    while (( $# )); do
        if [[ "$1" == -- ]]; then shift; agent_args=("$@"); break; fi
        nono_args+=("$1"); shift
    done
    # nono provides the sandbox boundary; Codex must not nest its own sandbox.
    CODEX_HOME="$codex_home" nono run --allow-cwd --profile "$profile" \
        "${nono_args[@]}" -- codex --dangerously-bypass-approvals-and-sandbox \
        "${agent_args[@]}"
}

# Codex writes its own config.toml, so each home is seeded once instead of
# stowed. Keep the home list in sync with the cx-* aliases below.
codex-home-install() {
    local defaults="${${(%):-%x}:A:h:h:h:h}/codex/config.defaults.toml"
    local home_dir

    if [[ ! -r $defaults ]]; then
        print -u2 "codex-home-install: missing defaults: $defaults"
        return 1
    fi

    for home_dir in "$HOME/.codex-personal" "$HOME/.codex-work"; do
        if [[ -L $home_dir ]]; then
            print -u2 "codex-home-install: refusing: $home_dir is a symlink; unstow the codex module, then rerun"
            return 1
        fi

        command mkdir -m 700 -p "$home_dir" || return

        if [[ -e $home_dir/config.toml ]]; then
            print -u2 "codex-home-install: kept existing $home_dir/config.toml"
        else
            command cp -- "$defaults" "$home_dir/config.toml" || return
            command chmod 600 "$home_dir/config.toml"
            print -u2 "codex-home-install: seeded $home_dir/config.toml"
        fi
    done
}

alias cc-lore='_nono_claude claude-code-personal "$HOME/.claude-personal"'
alias cc-work='_nono_claude claude-code-work "$HOME/.claude-work"'
alias cx-lore='_nono_codex codex-personal "$HOME/.codex-personal"'
alias cx-work='_nono_codex codex-work "$HOME/.codex-work"'
